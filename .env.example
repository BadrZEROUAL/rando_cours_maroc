# === Base de données Supabase ===
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@db.XXXXX.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:MOT_DE_PASSE@db.XXXXX.supabase.co:5432/postgres

# === Supabase Auth ===
SUPABASE_URL=https://XXXXX.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=ton-jwt-secret-supabase

# === API Claude Sonnet ===
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# === Redis (cache questions + détection partage) ===
REDIS_URL=redis://localhost:6379
REDIS_TTL_QUESTIONS=604800
# 7 jours en secondes

# === SMS Maroc (Mtarget) ===
MTARGET_API_KEY=ta-cle-mtarget
MTARGET_SENDER=RANDOCOURS
MTARGET_API_URL=https://api.mtarget.ma/v2/messages

# === Sécurité QR Codes ===
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
QR_JWT_SECRET=GENERER_UNE_CHAINE_64_CARACTERES_ICI
QR_JWT_EXPIRY=1800
# 30 minutes en secondes

# === AWS S3 — Certifications ===
AWS_REGION=me-south-1
